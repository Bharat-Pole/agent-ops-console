{% if vertex %}
# Vertex AI (ChatVertexAI) — application default credentials
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
{% else %}
# Google AI Studio (ChatGoogleGenerativeAI)
GOOGLE_API_KEY=your-gemini-api-key
{% endif %}
# Optional model override (defaults to the config's model_primary)
MODEL={{ model.primary }}
{% if rag %}
# Local vector store directory (Chroma)
VECTOR_DIR=./chroma_db
{% endif %}
{% if secret_names %}
# Vault secret references from the agent config (set real values here — never committed)
{% for sname in secret_names %}
{{ sname }}=
{% endfor %}
{% endif %}
