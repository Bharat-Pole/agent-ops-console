"""Model factory — {{ 'Vertex AI' if vertex else 'Google AI Studio' }} (Gemini).

Generated by agent_forge from model_primary={{ model.primary | tojson }}
(temperature={{ model.temperature }}, max_output_tokens={{ model.max_output_tokens }}).

NOTE: build_model() returns the plain chat model — no .with_retry()/.with_fallbacks()
wrappers, because those return Runnables without bind_tools/with_structured_output
and break tool-calling agents. Retries use the client's max_retries; switch to the
fallback model via the MODEL env var or build_fallback_model().
"""
import os
{% if vertex %}
from langchain_google_vertexai import ChatVertexAI
{% else %}
from langchain_google_genai import ChatGoogleGenerativeAI
{% endif %}

_PRIMARY = {{ model.primary | tojson }}
_FALLBACK = {{ (model.fallback | tojson) if model.fallback else "None" }}
_TEMPERATURE = {{ model.temperature }}
_MAX_TOKENS = {{ model.max_output_tokens }}
_RETRIES = {{ model.retries }}


def has_credentials() -> bool:
    """True when runtime credentials are present (so we can build the real model)."""
{% if vertex %}
    return bool(os.getenv("GOOGLE_CLOUD_PROJECT"))
{% else %}
    return bool(os.getenv("GOOGLE_API_KEY") or os.getenv("GEMINI_API_KEY"))
{% endif %}


def _make(model_id: str):
{% if vertex %}
    return ChatVertexAI(model=model_id, temperature=_TEMPERATURE,
                        max_output_tokens=_MAX_TOKENS, max_retries=_RETRIES + 1)
{% else %}
    return ChatGoogleGenerativeAI(model=model_id, temperature=_TEMPERATURE,
                                  max_output_tokens=_MAX_TOKENS, max_retries=_RETRIES + 1)
{% endif %}


def build_model():
    """Primary Gemini chat model (plain — safe for bind_tools)."""
    return _make(os.getenv("MODEL", _PRIMARY))


def build_fallback_model():
    """Fallback model, or None when the config declares none."""
    return _make(_FALLBACK) if _FALLBACK else None
