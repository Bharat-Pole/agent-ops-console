# Copy this file to .env and fill in real values. .env is gitignored.
# NEVER put a real key in this file — it is committed.

# Postgres connection.
# NOTE: the port is 5434, not the Postgres default 5432 — a native Windows
# PostgreSQL service commonly squats on 5432 and silently shadows the project's
# container. docker-compose.yml maps 5434 to match.
DATABASE_URL=postgres://postgres:postgres@localhost:5434/agent_ops

# Backend server port
PORT=8787

# Anthropic API key for real Playground chat. The server boots without it;
# only POST /v1/agents/:id/chat requires it (returns 503 if missing).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional per-tier model overrides
# ANTHROPIC_MODEL_MINIMAL=claude-haiku-4-5-20251001
# ANTHROPIC_MODEL_STANDARDIZED=claude-sonnet-5
# ANTHROPIC_MODEL_ADVANCED=claude-opus-5

# OpenAI API key for embeddings-based RAG retrieval. The server boots without it
# (the seed embedding step logs a warning and skips); RAG-enabled agents fall
# back to ungrounded general answers until it is set and the server restarted.
OPENAI_API_KEY=sk-proj-your-key-here

# Optional embedding model override
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
