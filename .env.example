# Copy this file to .env and fill in real values. .env is gitignored.

# Postgres connection (matches docker-compose.yml defaults)
DATABASE_URL=postgres://postgres:rishabh@localhost:5432/agent_ops

# Express server port
PORT=8787

# Anthropic API key for real Playground chat (Phase 2). Server boots without it;
# only POST /v1/agents/:id/chat requires it (returns 503 if missing).
ANTHROPIC_API_KEY=

# Optional per-tier model overrides — defaults are set in server/services/claude.ts
# ANTHROPIC_MODEL_MINIMAL=claude-haiku-4-5-20251001
# ANTHROPIC_MODEL_STANDARDIZED=claude-sonnet-5
# ANTHROPIC_MODEL_ADVANCED=claude-opus-5

# OpenAI API key for real embeddings-based RAG retrieval (Phase 3). Server boots
# without it (seed embedding step logs a warning and skips); RAG-enabled agents
# fall back to ungrounded general answers until it's set and the server restarted.
OPENAI_API_KEY=

# Optional embedding model override — default is set in server/env.ts
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
